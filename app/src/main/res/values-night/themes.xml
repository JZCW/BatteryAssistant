<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BatteryAssistant" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- App custom semantic colors -->
        <item name="baColorListItemHighlight">@color/list_item_highlight</item>
        <item name="baColorChartHighlight">@color/chart_highlight</item>
        <item name="baColorStatsBackground">@color/stats_background</item>
        <item name="baColorStatsCardBackground">@color/stats_card_background</item>
        <item name="baColorStatsPrimaryText">@color/stats_primary_text</item>
        <item name="baColorStatsSecondaryText">@color/stats_secondary_text</item>
        <item name="baColorStatsAccent">@color/stats_accent</item>
        <!-- Customize your theme here. -->
    </style>
</resources>