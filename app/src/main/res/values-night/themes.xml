<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.BatteryAssistant" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- App custom semantic colors -->
        <item name="baColorBrand">@color/purple_200</item>
        <item name="baColorBrandVariant">@color/purple_700</item>
        <item name="baColorOnBrand">@color/black</item>
        <item name="baColorSupport">@color/teal_200</item>
        <item name="baColorSupportVariant">@color/teal_200</item>
        <item name="baColorOnSupport">@color/black</item>
        <item name="baColorStatusBar">?attr/colorPrimary</item>
        <item name="baColorListItemHighlight">@color/list_item_highlight</item>
        <item name="baColorChartHighlight">@color/chart_highlight</item>
        <item name="baColorStatsBackground">@color/stats_background</item>
        <item name="baColorStatsCardBackground">@color/stats_card_background</item>
        <item name="baColorStatsPrimaryText">@color/stats_primary_text</item>
        <item name="baColorStatsSecondaryText">@color/stats_secondary_text</item>
        <item name="baColorStatsAccent">@color/stats_accent</item>
        <item name="baColorAppBackground">?attr/colorBackgroundFloating</item>
        <item name="baColorSurface">?attr/colorSurface</item>
        <item name="baColorAccent">?attr/baColorBrand</item>
        <item name="baColorDivider">?android:textColorSecondary</item>
        <item name="baColorPrimaryText">?android:textColorPrimary</item>
        <item name="baColorSecondaryText">?android:textColorSecondary</item>
        <item name="colorPrimary">?attr/baColorBrand</item>
        <item name="colorPrimaryVariant">?attr/baColorBrandVariant</item>
        <item name="colorOnPrimary">?attr/baColorOnBrand</item>
        <item name="colorSecondary">?attr/baColorSupport</item>
        <item name="colorSecondaryVariant">?attr/baColorSupportVariant</item>
        <item name="colorOnSecondary">?attr/baColorOnSupport</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="baTextStrokeEnabled">false</item>
        <item name="baTextStrokeColor">@color/black</item>
        <item name="baTextStrokeWidth">0</item>
        <!-- Customize your theme here. -->
    </style>
</resources>