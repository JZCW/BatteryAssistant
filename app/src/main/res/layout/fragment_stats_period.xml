<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/baColorStatsBackground">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/stats_period_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_daily"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_tab_daily" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_weekly"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_tab_weekly" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_monthly"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/stats_tab_monthly" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/stats_chart"
                    android:layout_width="match_parent"
                    android:layout_height="240dp"
                    android:layout_marginBottom="16dp" />

                

                <com.upo.batteryassistant.ui.StrokeTextView
                    android:id="@+id/detail_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/stats_detail_hint"
                    android:textColor="?attr/baColorStatsSecondaryText"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/detail_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/baColorStatsCardBackground"
                    app:cardCornerRadius="16dp"
                    app:cardUseCompatPadding="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <com.upo.batteryassistant.ui.StrokeTextView
                            android:id="@+id/detail_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/baColorStatsPrimaryText"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <com.upo.batteryassistant.ui.StrokeTextView
                            android:id="@+id/detail_description"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?attr/baColorStatsSecondaryText"
                            android:textSize="14sp" />

                        <com.upo.batteryassistant.ui.StrokeTextView
                            android:id="@+id/detail_session_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:textColor="?attr/baColorStatsPrimaryText"
                            android:textSize="15sp" />

                        <com.upo.batteryassistant.ui.StrokeTextView
                            android:id="@+id/detail_level_change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/baColorStatsPrimaryText"
                            android:textSize="15sp" />

                        <com.upo.batteryassistant.ui.StrokeTextView
                            android:id="@+id/detail_charge_counter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/baColorStatsPrimaryText"
                            android:textSize="15sp" />

                        <com.upo.batteryassistant.ui.StrokeTextView
                            android:id="@+id/detail_estimated_capacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/baColorStatsPrimaryText"
                            android:textSize="15sp" />

                        <com.upo.batteryassistant.ui.StrokeTextView
                            android:id="@+id/detail_cycle_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/baColorStatsPrimaryText"
                            android:textSize="15sp" />

                        <com.upo.batteryassistant.ui.StrokeTextView
                            android:id="@+id/detail_capacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/baColorStatsPrimaryText"
                            android:textSize="15sp" />

                        <com.upo.batteryassistant.ui.StrokeTextView
                            android:id="@+id/detail_max_level_change"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="?attr/baColorStatsPrimaryText"
                            android:textSize="15sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <com.upo.batteryassistant.ui.StrokeTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="容量散点图（estimated_capacity）"
                    android:textColor="?attr/baColorStatsPrimaryText"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/capacity_range_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_capacity_3m"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最近3个月" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_capacity_12m"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="最近12个月" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_capacity_all"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="全部时间" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.github.mikephil.charting.charts.ScatterChart
                    android:id="@+id/capacity_scatter_chart"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginBottom="8dp" />

                <com.upo.batteryassistant.ui.StrokeTextView
                    android:id="@+id/capacity_detail_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/baColorStatsSecondaryText"
                    android:textSize="14sp"
                    android:layout_marginBottom="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_charge_history"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/btn_charge_history"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            </LinearLayout>
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.upo.batteryassistant.ui.StrokeTextView
        android:id="@+id/empty_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/stats_empty_state"
        android:textColor="?attr/baColorStatsPrimaryText"
        android:textSize="16sp"
        android:visibility="gone" />

</FrameLayout>
