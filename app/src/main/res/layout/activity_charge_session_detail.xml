                    android:textColor="?attr/baColorSecondaryText" />

                <TextView
                    android:id="@+id/detail_ongoing_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_body" />

                <TextView
