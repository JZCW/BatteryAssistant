                    android:textColor="?attr/baColorPrimaryText" />

                <TextView
                    android:id="@+id/detail_nondoze_duration_text_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/detail_label_nondoze_duration"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="?attr/baColorSecondaryText" />

                <TextView
                    android:id="@+id/detail_nondoze_duration_text"
                    android:layout_width="wrap_content"
