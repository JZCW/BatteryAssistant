                    android:id="@+id/detail_start_level_text_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/detail_label_start_level"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="?attr/baColorSecondaryText" />

                <TextView
                    android:id="@+id/detail_start_level_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/detail_end_level_text_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
