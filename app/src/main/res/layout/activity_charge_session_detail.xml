                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/detail_end_time_text_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/detail_label_end_time"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="?attr/baColorSecondaryText" />

                <TextView
                    android:id="@+id/detail_end_time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/detail_duration_text_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/detail_label_duration"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="?attr/baColorSecondaryText" />

                <TextView
                    android:id="@+id/detail_duration_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_body" />

                <TextView
                    android:id="@+id/detail_pause_time_text_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:text="@string/detail_label_pause_time"
                    android:textSize="@dimen/text_size_body"
                    android:textColor="?attr/baColorSecondaryText" />

                <TextView
                    android:id="@+id/detail_pause_time_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/text_size_body" />

                <TextView
