<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/stats_background">

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/stats_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/stats_card_background"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabTextColor="@color/stats_secondary_text"
        app:tabSelectedTextColor="@color/stats_primary_text"
        app:tabIndicatorColor="@color/stats_accent"
        app:tabRippleColor="@android:color/transparent" />

    <FrameLayout
        android:id="@+id/stats_content_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
